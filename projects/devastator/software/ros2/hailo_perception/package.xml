<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hailo_perception</name>
  <version>0.1.0</version>
  <description>Object detection and face recognition on a Raspberry Pi AI HAT+ 2 (Hailo-10H), as ROS 2 topics. The Devastator's intent-tier perception node, developed on the family's bench Pi 5.</description>
  <maintainer email="wayne@zappfyre.com">Wayne Kennedy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>usb_cam</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
