# HAT perception bench at boot: usb_cam + hailo_perception + web_video_server, as scripts/launch.sh.
# Follows wk-robotics docs/common.md → Robot startup is familial. Installed by ./install.sh, which fills the
# __PLACEHOLDERS__ from the checkout; no user or path is baked in.
[Unit]
Description=AI HAT+ 2 perception bench (USB camera -> hailo_perception -> web_video_server :8080)
# time-sync.target: the bench Pi 5 has no battery-backed clock (its RTC read 1970 at the 2026-09-19
# boot; NTP answered 53 s later), so without this the stack can start on the wrong time.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO_DIR__
Environment=HOME=__HOME__
ExecStart=__REPO_DIR__/scripts/launch.sh
# ros2 launch shuts its nodes down cleanly on SIGINT. KillMode=mixed sends it to ros2 launch
# alone; the default (control-group) also signals every node directly, so each got SIGINT
# twice and the second interrupted its shutdown (traceback seen 2026-09-21).
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
# Killing only the launch can orphan the camera node, which then holds /dev/video*
# (scripts/stop.sh header). Sweep anything left before a restart.
ExecStopPost=-__REPO_DIR__/scripts/stop.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
