<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orin_perception</name>
  <version>0.1.0</version>
  <description>Perception bench on the Jetson Orin Nano: YOLOv8 objects plus SCRFD/ArcFace face recognition on TensorRT, annotated stream to a browser.</description>
  <maintainer email="wayne@zappfyre.com">Wayne Kennedy</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
